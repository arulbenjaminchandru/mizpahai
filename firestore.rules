rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true
      );
    }

    function isStudentActive() {
      return isSignedIn() &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'suspended');
    }

    // Check if the current user is enrolled in the given course
    function isEnrolled(courseId) {
      return isSignedIn() && isStudentActive() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId))
      );
    }

    // ─── Collection: users ─────────────────────────────────────────────────
    match /users/{userId} {
      // Users can read and update their own document, admins can read and write any user
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'student';
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Collection: courses ───────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Collection: weeks ─────────────────────────────────────────────────
    match /weeks/{weekId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Collection: modules ───────────────────────────────────────────────
    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Collection: lessons ───────────────────────────────────────────────
    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Collection: resources ─────────────────────────────────────────────
    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Collection: enrollmentCodes ───────────────────────────────────────
    match /enrollmentCodes/{codeId} {
      allow read, update: if isSignedIn();
      allow create, delete: if isAdmin();
    }

    // ─── Collection: enrollments ───────────────────────────────────────────
    match /enrollments/{enrollmentId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ─── Collection: lessonProgress ────────────────────────────────────────
    match /lessonProgress/{progressId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ─── Deny All Other Unmatched Paths ────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

